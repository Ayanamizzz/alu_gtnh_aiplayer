      "2026 Samiracle64",
      "2026 jackwrichards"
    ]
  },
  "referenceMod": {
    "url": "https://github.com/jackwrichards/gtnh-planner-mod",
    "commit": "69dd09fe21117d7b8558625dc9556723873942ca",
    "license": "MIT",
    "copyright": [
      "2026 Sbancuz"
    ],
    "purpose": "Independent machine-math comparison and common solver corpus; not a runtime dependency."
  },
  "packages": {
    "esbuild": {
      "version": "0.28.2",
      "role": "build only",
      "license": "MIT"
    },
    "highs": {
      "version": "1.15.2",
      "role": "bundled runtime JS and WASM",
      "license": "MIT"
    },
    "zod": {
      "version": "4.4.3",
      "role": "bundled runtime validation",
      "license": "MIT"
    }
  },
  "runtime": [
    "dist/runtime.cjs",
    "dist/catalog.mjs",
    "dist/highs.wasm",
    "mod/handlers.json"
  ],
  "modifications": [
    "Upstream snapshots are byte-identical. Build-time lp-observability.json adds call counters and bounded failure messages; no mathematical changes.",
    "Project-owned runtime-entry.ts adds upstream schema validation, reserved/duplicate identifier checks, and raw SolveInputJson validation.",
    "Node worker requires HiGHS to initialize, supplies an import.meta.url-relative WASM path, and never fetches assets.",
    "types/model.d.ts converts the two numeric constants into ambient declarations and rewrites the sole type import to ./plan-types.js; types/plan-types.d.ts is verbatim upstream."
  ],
  "build": {
    "command": "node brain/vendor/gtnh-planner/generate.mjs --tools /path/to/isolated-toolchain",
    "lockfile": "toolchain/package-lock.json",
    "sourceHashes": "source-files.json",
    "outputHashes": {
      "dist/runtime.cjs": "bcc5e162a72bcc682349db72bcad3184fa9c4706784646921ba6e908593fb8dd",
